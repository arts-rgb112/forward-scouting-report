VITE_MESSI_API_BASE_URL=https://api.example.com
VITE_MESSI_SEASON=2025/2026
VITE_MESSI_SCOPE=7
VITE_MESSI_LIMIT=1000
VITE_DUEL_PRESS_LEADERBOARD_ENABLED=true
# Optional detail-only rollback. The global legacy flag continues to apply only to Compare/About.
VITE_VOLUME_BENCHMARK_ENABLED=false
VITE_RATIO_BENCHMARK_ENABLED=false
VITE_TACTICAL_SUMMARY_ENABLED=false
# Exact opt-in for the native player-detail Final Third Shot Chart. Any value other
# than the literal string "true" keeps the endpoint idle.
VITE_FINAL_THIRD_SHOT_MAP_ENABLED=false
# Exact opt-in. Any value other than the string "true" keeps the established V2 watchlist path.
VITE_WATCHLIST_V3_ENABLED=false
