VITE_MESSI_API_BASE_URL=https://api.example.com
VITE_MESSI_SEASON=2025/2026
VITE_MESSI_SCOPE=7
VITE_MESSI_LIMIT=1000
# Optional GA4 client telemetry. Leave empty to avoid loading Google Analytics.
VITE_GA_MEASUREMENT_ID=
VITE_DUEL_PRESS_LEADERBOARD_ENABLED=true
# V2 stat-pairs transport is fail-closed until immutable Preview QA passes.
VITE_DUEL_PRESS_V2_ENABLED=false
# Optional detail-only rollback. The global legacy flag continues to apply only to Compare/About.
VITE_VOLUME_BENCHMARK_ENABLED=false
VITE_RATIO_BENCHMARK_ENABLED=false
VITE_TACTICAL_SUMMARY_ENABLED=false
# Exact opt-in for the additive tactical-summary-v2 contract. Any other value
# keeps the established v1 tactical summary and makes no v2 request.
VITE_TACTICAL_SUMMARY_V2_ENABLED=false
# Exact opt-in for the native player-detail Final Third Shot Chart. Any value other
# than the literal string "true" keeps the endpoint idle.
VITE_FINAL_THIRD_SHOT_MAP_ENABLED=false
# Opt-in to the strict effective-shot v2 contract. Keep false to retain v1.
VITE_FINAL_THIRD_SHOT_MAP_V2_ENABLED=false
# Opt-in to the strict Goal-Mouth v3 summary and 3D renderer; keep false until Preview QA.
VITE_FINAL_THIRD_SHOT_MAP_V3_ENABLED=false
# Exact opt-in for the global five-season Goal-Mouth background. Keep false until separate release approval.
VITE_GOAL_MOUTH_BASELINE_ENABLED=false
VITE_BENCHMARK_RADAR_V2_ENABLED=false
# Exact opt-in. Any value other than the string "true" keeps the established V2 watchlist path.
VITE_WATCHLIST_V3_ENABLED=false
